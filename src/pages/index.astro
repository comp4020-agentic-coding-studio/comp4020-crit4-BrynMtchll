---
import {
  BASS_LINES,
  GROOVES,
  PHRASES,
  PRESETS,
  PROGRESSIONS,
  SCALES,
  VOICES,
  VOWELS,
} from "../lib/music";
import "../styles/global.css";
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carousel</title>
    <meta
      name="description"
      content="Draw a spectrogram and hear it. A looping drawing machine with chord progressions, grooves and synth voices — every mark lands in key."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL}>Home</a>
      </nav>
    </header>

    <main>
      <section data-stage>
        <canvas
          data-grid
          tabindex="0"
          role="application"
          aria-label="Drawing loop. Drag to paint sound. Up and down arrows choose a pitch, Enter paints it at the play bar."
        ></canvas>
        <div data-invitation>
          <h1>Draw to play</h1>
          <p data-testid="intro">Drums low, bass in the middle, notes up top.</p>
        </div>
      </section>

      <!--
        Presets first and everything else folded away. The crit opens with a
        stranger playing this before a word is said, so the top level stays a
        canvas and a row of names; the desk is there for anyone who opens it.
      -->
      <div data-presets role="group" aria-label="Presets">
        {
          PRESETS.map((preset) => (
            <button type="button" data-preset={preset.id}>
              {preset.name}
            </button>
          ))
        }
        <button type="button" data-clear>Clear</button>
      </div>

      <!--
        Continuation. Kept off the canvas and out of the way: a stranger who
        never presses these loses nothing, and the model only downloads when
        one of them is pressed for the first time.
      -->
      <div data-suggest>
        <button type="button" data-continue="melody">Continue melody</button>
        <button type="button" data-continue="drums">Continue drums</button>
        <span data-status role="status" aria-live="polite"></span>
      </div>

      <!--
        Things to plug in. Each of these writes into one region and leaves the
        others alone, so a beat, a bass line and a phrase can be stacked in
        three clicks and then drawn over.
      -->
      <div data-bank role="group" aria-label="Beats">
        <span data-label>Beat</span>
        {
          GROOVES.map((groove) => (
            <button type="button" data-groove={groove.id}>
              {groove.name}
            </button>
          ))
        }
      </div>

      <div data-bank role="group" aria-label="Bass lines">
        <span data-label>Bass</span>
        {
          BASS_LINES.map((line) => (
            <button type="button" data-bassline={line.id}>
              {line.name}
            </button>
          ))
        }
      </div>

      <div data-bank role="group" aria-label="Phrases">
        <span data-label>Phrase</span>
        {
          PHRASES.map((phrase) => (
            <button type="button" data-phrase={phrase.id}>
              {phrase.name}
            </button>
          ))
        }
      </div>

      <p data-keys>
        <kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><kbd>F</kbd><kbd>G</kbd><kbd>H</kbd
        ><kbd>J</kbd><kbd>K</kbd> play the kit — a press sounds now and records
        itself on the beat.
      </p>

      <details data-desk>
        <summary>More</summary>

        <div data-rack>
          <label>
            Voice
            <select data-pick="voice">
              {VOICES.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>

          <label>
            Bass
            <select data-pick="bass">
              {VOICES.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>

          <label>
            Vowel
            <select data-pick="vowel">
              {VOWELS.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>

          <label>
            Chords
            <select data-pick="progression">
              {
                PROGRESSIONS.map((p) => <option value={p.id}>{p.name}</option>)
              }
            </select>
          </label>

          <label>
            Scale
            <select data-pick="scale">
              {SCALES.map((s) => <option value={s.id}>{s.name}</option>)}
            </select>
          </label>

          <label>
            Tone
            <input
              type="range"
              data-knob="cutoff"
              min="300"
              max="9000"
              step="50"
              value="2200"
            />
          </label>

          <label>
            Bite
            <input
              type="range"
              data-knob="resonance"
              min="0"
              max="18"
              step="0.5"
              value="2"
            />
          </label>

          <label>
            Swing
            <input
              type="range"
              data-knob="swing"
              min="0"
              max="0.85"
              step="0.05"
              value="0"
            />
          </label>

          <label>
            Length
            <input
              type="range"
              data-knob="loop"
              min="2.5"
              max="12"
              step="0.5"
              value="6"
            />
          </label>

          <div data-switches>
            <button type="button" data-toggle="chords" aria-pressed="true">
              Harmony
            </button>
            <button type="button" data-toggle="voice" aria-pressed="true">
              Voicing
            </button>
            <button type="button" data-toggle="arp" aria-pressed="false">
              Arp
            </button>
            <button type="button" data-toggle="snap" aria-pressed="true">
              Snap
            </button>
          </div>

          <p data-hint>Hold shift to rub out.</p>
        </div>
      </details>
    </main>

    <script>
      import {
        BASS_BANDS,
        BASS_LINES,
        DRUM_KEYS,
        GROOVES,
        PHRASES,
        KEY_HZ,
        KEY_MIDI,
        PRESETS,
        PERCUSSION,
        PERC_BANDS,
        PROGRESSIONS,
        SCALES,
        SUBDIVS,
        VOICES,
        VOWELS,
        bandForDrumMidi,
        drumMidi,
        byId,
        semitoneOf,
        swingOffset,
        voiceOffsets,
      } from "../lib/music";
      import type { Beat, Note } from "../lib/suggest";
      import { continueDrums, continueMelody } from "../lib/suggest";

      const canvas = document.querySelector<HTMLCanvasElement>("[data-grid]");
      const stage = document.querySelector<HTMLElement>("[data-stage]");

      const FIELD_W = 512;

      // Three regions stacked bottom to top: the kit, the bass, the lead. Each
      // is a separate instrument with its own synth, and a stroke can never
      // cross between them — a melody must not be able to play the drums.
      const PERC = PERC_BANDS;
      const BASS = BASS_BANDS;
      const TONE_BANDS = 16;
      const BANDS = PERC + BASS + TONE_BANDS;
      const BASS_FROM = PERC;
      const LEAD_FROM = PERC + BASS;

      const regionOf = (band: number) =>
        band < PERC ? 0 : band < LEAD_FROM ? 1 : 2;

      const BARS = 4;
      const SUB_COLS = FIELD_W / SUBDIVS;
      const BAR_COLS = FIELD_W / BARS;
      const BAR_FRAC = 0.18;

      const VOICE_LEVELS = [0.5, 0.32];
      const BRUSH_X = 7;
      const BRUSH_Y = 1.3;

      // Drums get almost no vertical spread. At the wider brush a hit bled
      // enough into the band above to cross its onset threshold, so every kick
      // fired the tom underneath it and the kit sounded like mush.
      const BRUSH_Y_DRUM = 0.55;

      const TAP = 0.45;
      const FLOW = 0.09;
      const ONSET = 0.18;
      const AUDIO_TICK_MS = 10;
      const SILENCE = 0.04;

      const field = new Float32Array(FIELD_W * BANDS);
      const targets = new Float32Array(TONE_BANDS);
      const shown = new Float32Array(FIELD_W * BANDS);

      let voice = VOICES[0];
      let bass = VOICES[10]; // Round
      let vowel = VOWELS[0];
      let progression = PROGRESSIONS[0];
      let scale = SCALES[0];
      let cutoff = 2200;
      let resonance = 2;
      let swing = 0;
      let loopS = 6;

      let locked = true; // bands follow the progression
      let voicing = true;
      let arping = false;
      let snapping = true;

      type Bank = {
        osc: OscillatorNode;
        gain: GainNode;
        mod: OscillatorNode;
        modGain: GainNode;
      };
      type Audio = {
        ctx: AudioContext;
        master: GainNode;
        filter: BiquadFilterNode;
        noise: AudioBuffer;
        voices: Bank[];
        bassVoices: Bank[];
        formants: BiquadFilterNode[];
        dry: GainNode;
        wet: GainNode;
        startedAt: number;
      };

      let audio: Audio | null = null;
      let audioTimer: number | undefined;
      let frame: number | undefined;

      let painting = false;
      let erasing = false;
      let pointerX = 0;
      let pointerY = 0;
      let lastMark: [number, number] | null = null;
      let cursorBand = LEAD_FROM + 4;
      let showCursor = false;

      let tunedTo = -1;
      let lastSub = -1;
      let arpStep = 0;
      const lastDrum = new Float32Array(PERC);

      const off = document.createElement("canvas");
      off.width = FIELD_W;
      off.height = BANDS;
      const offCtx = off.getContext("2d");
      const offImage = offCtx?.createImageData(FIELD_W, BANDS);

      const at = (col: number, band: number) => band * FIELD_W + col;
      const chordAt = (col: number) =>
        Math.floor(col / BAR_COLS) % BARS;

      // Locked to the progression, a band is a chord tone; unlocked, a degree
      // of the scale. Both are just an ascending set of semitones, so the same
      // layout function serves either.
      const tonesFor = (chord: number) =>
        locked ? progression.bars[chord].tones : scale.steps;

      // ---- sound ------------------------------------------------------------

      function makeNoise(ctx: AudioContext): AudioBuffer {
        const buffer = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        return buffer;
      }

      // One oscillator plus its modulator, wired into a destination. The
      // modulator is always present; a voice without FM just runs it at zero
      // depth, so changing voice is a matter of setting numbers rather than
      // rebuilding the graph under a sounding note.
      function makeBank(
        ctx: AudioContext,
        into: AudioNode,
        spec: { wave: OscillatorType },
      ): Bank {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const mod = ctx.createOscillator();
        const modGain = ctx.createGain();

        osc.type = spec.wave;
        gain.gain.value = 0;
        modGain.gain.value = 0;

        mod.connect(modGain).connect(osc.frequency);
        mod.start();
        osc.connect(gain).connect(into);
        osc.start();

        return { osc, gain, mod, modGain };
      }

      function ensureAudio(): Audio {
        if (audio) return audio;

        const ctx = new AudioContext();
        const master = ctx.createGain();
        const filter = ctx.createBiquadFilter();
        const squash = ctx.createDynamicsCompressor();

        filter.type = "lowpass";
        filter.frequency.value = cutoff;
        filter.Q.value = resonance;

        squash.threshold.value = -20;
        squash.ratio.value = 10;

        master.gain.value = 0.9;
        master.connect(filter).connect(squash).connect(ctx.destination);

        // The lead runs through a formant bank so it can be made to sound like
        // a vowel. Three bandpass filters in parallel at the resonances of a
        // vocal tract, mixed against the plain signal — the same trick a
        // vocoder uses, and no recording anywhere near it.
        const leadBus = ctx.createGain();
        const dry = ctx.createGain();
        const wet = ctx.createGain();

        dry.gain.value = 1;
        wet.gain.value = 0;
        leadBus.connect(dry).connect(master);

        const formants: BiquadFilterNode[] = [];
        for (let i = 0; i < 3; i++) {
          const band = ctx.createBiquadFilter();
          band.type = "bandpass";
          band.frequency.value = 500;
          band.Q.value = 9;
          leadBus.connect(band).connect(wet);
          formants.push(band);
        }
        wet.connect(master);

        const bassBus = ctx.createGain();
        bassBus.gain.value = 1;
        bassBus.connect(master);

        const voices: Bank[] = [];
        for (let i = 0; i < TONE_BANDS; i++) {
          voices.push(makeBank(ctx, leadBus, voice));
        }

        const bassVoices: Bank[] = [];
        for (let i = 0; i < BASS; i++) {
          bassVoices.push(makeBank(ctx, bassBus, bass));
        }

        audio = {
          ctx,
          master,
          filter,
          noise: makeNoise(ctx),
          voices,
          bassVoices,
          formants,
          dry,
          wet,
          startedAt: 0,
        };
        applyVoice();
        applyVowel();
        return audio;
      }

      function applyVoice(): void {
        if (!audio) return;
        const now = audio.ctx.currentTime;

        for (const bank of audio.voices) {
          bank.osc.type = voice.wave;
          bank.modGain.gain.setTargetAtTime(voice.fmDepth, now, 0.02);
        }
        for (const bank of audio.bassVoices) {
          bank.osc.type = bass.wave;
          bank.modGain.gain.setTargetAtTime(bass.fmDepth, now, 0.02);
        }
        tunedTo = -1; // modulator frequencies follow the carriers
      }

      function applyVowel(): void {
        if (!audio) return;
        const now = audio.ctx.currentTime;
        const on = vowel.formants.length > 0;

        // Some plain signal is kept even at full vowel: formants alone are thin
        // and lose the bottom of the note entirely.
        audio.dry.gain.setTargetAtTime(on ? 0.35 : 1, now, 0.05);
        audio.wet.gain.setTargetAtTime(on ? 1.6 : 0, now, 0.05);

        if (!on) return;
        for (let i = 0; i < audio.formants.length; i++) {
          audio.formants[i].frequency.setTargetAtTime(
            vowel.formants[i],
            now,
            0.05,
          );
        }
      }

      function applyFilter(): void {
        if (!audio) return;
        const now = audio.ctx.currentTime;
        audio.filter.frequency.setTargetAtTime(cutoff, now, 0.03);
        audio.filter.Q.setTargetAtTime(resonance, now, 0.03);
      }

      function envelope(
        active: Audio,
        when: number,
        peak: number,
        decay: number,
      ): GainNode {
        const gain = active.ctx.createGain();
        gain.gain.setValueAtTime(0, when);
        gain.gain.linearRampToValueAtTime(peak, when + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, when + decay);
        gain.connect(active.master);
        return gain;
      }

      function burst(
        active: Audio,
        when: number,
        type: BiquadFilterType,
        frequency: number,
        peak: number,
        decay: number,
      ): void {
        const source = active.ctx.createBufferSource();
        const shape = active.ctx.createBiquadFilter();

        source.buffer = active.noise;
        shape.type = type;
        shape.frequency.value = frequency;

        source.connect(shape).connect(envelope(active, when, peak, decay));
        source.start(when);
        source.stop(when + decay + 0.02);
      }

      function swept(
        active: Audio,
        when: number,
        from: number,
        to: number,
        bend: number,
        peak: number,
        decay: number,
      ): void {
        const osc = active.ctx.createOscillator();
        osc.type = "sine";
        osc.frequency.setValueAtTime(from, when);
        osc.frequency.exponentialRampToValueAtTime(to, when + bend);
        osc.connect(envelope(active, when, peak, decay));
        osc.start(when);
        osc.stop(when + decay + 0.04);
      }

      // Eight pieces that should never be mistaken for one another. Switched
      // on the kit's own ids rather than band numbers, so reordering the kit
      // cannot silently reassign a sound.
      function drum(active: Audio, band: number, when: number, level: number) {
        switch (PERCUSSION[band].id) {
          case "sub":
            // Long, low and nearly pure: the weight under the kick.
            swept(active, when, 72, 38, 0.07, level * 0.95, 0.8);
            break;
          case "kick":
            swept(active, when, 165, 48, 0.09, level * 0.95, 0.28);
            burst(active, when, "highpass", 3200, level * 0.16, 0.012);
            break;
          case "tom":
            swept(active, when, 260, 110, 0.18, level * 0.7, 0.34);
            break;
          case "snare":
            burst(active, when, "bandpass", 1800, level * 0.5, 0.15);
            swept(active, when, 190, 170, 0.1, level * 0.3, 0.1);
            break;
          case "clap":
            // Three fast taps and a tail. The stutter is what separates a clap
            // from a snare; a single burst just sounds like a bad snare.
            for (let i = 0; i < 3; i++) {
              burst(
                active,
                when + i * 0.011,
                "bandpass",
                1500,
                level * 0.28,
                0.05,
              );
            }
            burst(active, when + 0.034, "bandpass", 1150, level * 0.32, 0.13);
            break;
          case "rim":
            burst(active, when, "bandpass", 2600, level * 0.32, 0.028);
            swept(active, when, 420, 400, 0.02, level * 0.22, 0.03);
            break;
          case "hat":
            burst(active, when, "highpass", 9500, level * 0.3, 0.024);
            break;
          default:
            // Open hat: same metal, held long enough to ring into the next beat.
            burst(active, when, "highpass", 7000, level * 0.26, 0.24);
        }
      }

      function pluck(gain: GainNode, level: number, now: number): void {
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(Math.max(0.0001, gain.gain.value), now);
        gain.gain.linearRampToValueAtTime(level * level * 0.17, now + 0.006);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);
      }

      function position(): number {
        if (!audio || audioTimer === undefined) return -1;
        const elapsed = audio.ctx.currentTime - audio.startedAt;
        if (elapsed < 0) return 0;
        return ((elapsed / loopS) * FIELD_W) % FIELD_W;
      }

      function retune(active: Audio, chord: number, now: number): void {
        if (chord === tunedTo) return;
        tunedTo = chord;

        const tones = tonesFor(chord);
        for (let i = 0; i < active.voices.length; i++) {
          const hz = KEY_HZ * 2 ** (semitoneOf(i, tones) / 12);
          active.voices[i].osc.frequency.setTargetAtTime(hz, now, 0.02);
          if (voice.fmRatio > 0) {
            active.voices[i].mod.frequency.setTargetAtTime(
              hz * voice.fmRatio,
              now,
              0.02,
            );
          }
        }

        // The bass takes the same chord an octave down, so it can only ever
        // land on a note the harmony already contains.
        for (let i = 0; i < active.bassVoices.length; i++) {
          const hz = (KEY_HZ / 2) * 2 ** (semitoneOf(i, tones) / 12);
          active.bassVoices[i].osc.frequency.setTargetAtTime(hz, now, 0.02);
          if (bass.fmRatio > 0) {
            active.bassVoices[i].mod.frequency.setTargetAtTime(
              hz * bass.fmRatio,
              now,
              0.02,
            );
          }
        }
      }

      function listen(): void {
        const active = audio;
        if (!active) return;

        const scroll = position();
        if (scroll < 0) return;

        const col = Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W;
        const now = active.ctx.currentTime;

        retune(active, chordAt(col), now);

        targets.fill(0);
        const offsets = voiceOffsets(locked);

        for (let i = 0; i < TONE_BANDS; i++) {
          const raw = field[at(col, LEAD_FROM + i)];
          if (raw < SILENCE) continue;

          targets[i] = Math.min(1, targets[i] + raw);
          if (!voicing) continue;

          for (let v = 0; v < offsets.length; v++) {
            const to = i + offsets[v];
            if (to < TONE_BANDS) {
              targets[to] = Math.min(1, targets[to] + raw * VOICE_LEVELS[v]);
            }
          }
        }

        const sub = Math.floor(col / SUB_COLS);
        const crossed = sub !== lastSub;
        lastSub = sub;

        if (arping) {
          if (crossed) {
            const live: number[] = [];
            for (let i = 0; i < TONE_BANDS; i++) {
              if (targets[i] > 0) live.push(i);
            }
            if (live.length > 0) {
              pluck(
                active.voices[live[arpStep % live.length]].gain,
                targets[live[arpStep % live.length]],
                now,
              );
              arpStep++;
            } else {
              arpStep = 0;
            }
          }
        } else {
          for (let i = 0; i < TONE_BANDS; i++) {
            active.voices[i].gain.gain.setTargetAtTime(
              targets[i] * targets[i] * 0.13,
              now,
              0.04,
            );
          }
        }

        // The bass region. Always sustained, never arpeggiated and never
        // voiced into a chord: a bass line wants to be one note at a time.
        for (let i = 0; i < BASS; i++) {
          const raw = field[at(col, BASS_FROM + i)];
          const level = raw < SILENCE ? 0 : raw;
          active.bassVoices[i].gain.gain.setTargetAtTime(
            level * level * 0.32,
            now,
            0.05,
          );
        }

        for (let band = 0; band < PERC; band++) {
          const raw = field[at(col, band)];
          const level = raw < SILENCE ? 0 : raw;
          if (level >= ONSET && lastDrum[band] < ONSET) {
            drum(active, band, now, level);
          }
          lastDrum[band] = level;
        }
      }

      function hushVoices(): void {
        if (!audio) return;
        const now = audio.ctx.currentTime;
        for (const bank of [...audio.voices, ...audio.bassVoices]) {
          bank.gain.gain.cancelScheduledValues(now);
          bank.gain.gain.setTargetAtTime(0, now, 0.05);
        }
      }

      function start(): Audio {
        const active = ensureAudio();
        if (active.ctx.state === "suspended") void active.ctx.resume();

        if (audioTimer === undefined) {
          active.startedAt = active.ctx.currentTime;
          stage?.setAttribute("data-live", "");
          audioTimer = window.setInterval(listen, AUDIO_TICK_MS);
        }
        return active;
      }

      // Changing the length must not make the loop jump: hold the current
      // position and move the start time under it instead.
      function setLoop(next: number): void {
        if (audio && audioTimer !== undefined) {
          const held = position();
          loopS = next;
          audio.startedAt =
            audio.ctx.currentTime - (held / FIELD_W) * next;
          return;
        }
        loopS = next;
      }

      // ---- painting ---------------------------------------------------------

      function snapCol(col: number): number {
        const step = Math.round(col / SUB_COLS);
        const swung = (step + swingOffset(step, swing)) * SUB_COLS;
        return ((Math.round(swung) % FIELD_W) + FIELD_W) % FIELD_W;
      }

      function paint(
        col: number,
        band: number,
        wipe: boolean,
        amount: number,
      ): void {
        const region = regionOf(band);
        const drums = region === 0;
        if (snapping && !wipe && drums) col = snapCol(col);

        const spreadY = drums ? BRUSH_Y_DRUM : BRUSH_Y;
        const reachX = Math.ceil(BRUSH_X);
        const reachY = Math.ceil(spreadY);

        for (let dy = -reachY; dy <= reachY; dy++) {
          const y = band + dy;
          if (y < 0 || y >= BANDS) continue;

          // A note must never bleed into a drum, or a melody would play the kit.
          if (regionOf(y) !== region) continue;

          for (let dx = -reachX; dx <= reachX; dx++) {
            const falloff = 1 - Math.hypot(dx / BRUSH_X, dy / spreadY);
            if (falloff <= 0) continue;

            const x = (col + dx + FIELD_W) % FIELD_W;
            const i = at(x, y);
            const add = amount * falloff;

            if (wipe) {
              const next = field[i] - add * 2.5;
              field[i] = next < SILENCE ? 0 : next;
            } else {
              field[i] = Math.min(1, field[i] + add);
            }
          }
        }
      }

      function stroke(
        from: [number, number],
        to: [number, number],
        wipe: boolean,
        amount: number,
      ): void {
        let dx = to[0] - from[0];
        if (dx > FIELD_W / 2) dx -= FIELD_W;
        if (dx < -FIELD_W / 2) dx += FIELD_W;
        const dy = to[1] - from[1];

        const steps = Math.max(
          1,
          Math.ceil(Math.max(Math.abs(dx) / 2, Math.abs(dy) * 2)),
        );

        for (let i = 1; i <= steps; i++) {
          const t = i / steps;
          paint(
            Math.round(from[0] + dx * t + FIELD_W) % FIELD_W,
            Math.round(from[1] + dy * t),
            wipe,
            amount,
          );
        }
      }

      function stampGroove(id: string): void {
        for (let band = 0; band < PERC; band++) {
          for (let col = 0; col < FIELD_W; col++) field[at(col, band)] = 0;
        }
        for (const hit of byId(GROOVES, id).hits) {
          const swung = (hit.sub + swingOffset(hit.sub, swing)) * SUB_COLS;
          paint(Math.round(swung) % FIELD_W, hit.band, false, hit.level);
        }
      }

      // Writes a template into one region and clears only that region, so
      // plugging in a phrase never disturbs the beat under it.
      function stampPhrase(
        notes: { step: number; degree: number; steps: number }[],
        from: number,
        bands: number,
      ): void {
        for (let band = from; band < from + bands; band++) {
          for (let col = 0; col < FIELD_W; col++) field[at(col, band)] = 0;
        }
        for (const note of notes) {
          const band = from + (note.degree % bands);
          for (let s = 0; s < note.steps; s++) {
            const step = note.step + s;
            if (step >= SUBDIVS) break;
            paint(colOfStep(step), band, false, s === 0 ? 0.75 : 0.16);
          }
        }
      }

      function fieldFromScreen(
        clientX: number,
        clientY: number,
      ): [number, number] | null {
        if (!canvas) return null;

        const box = canvas.getBoundingClientRect();
        const fx = (clientX - box.left) / box.width;
        const fy = (clientY - box.top) / box.height;
        if (fx < 0 || fx > 1 || fy < 0 || fy > 1) return null;

        const scroll = Math.max(0, position());
        const col = Math.floor(scroll + fx * FIELD_W) % FIELD_W;
        const band = BANDS - 1 - Math.floor(fy * BANDS);
        return [col, Math.min(BANDS - 1, Math.max(0, band))];
      }

      // ---- drawing ----------------------------------------------------------

      const HEAT: [number, number, number][] = [
        [10, 12, 22],
        [40, 25, 92],
        [128, 38, 130],
        [220, 74, 96],
        [246, 150, 60],
        [255, 240, 170],
      ];

      function heat(level: number, out: Uint8ClampedArray, o: number): void {
        const scaled = Math.min(0.999, Math.max(0, level)) * (HEAT.length - 1);
        const i = Math.floor(scaled);
        const t = scaled - i;
        const a = HEAT[i];
        const b = HEAT[Math.min(HEAT.length - 1, i + 1)];

        out[o] = a[0] + (b[0] - a[0]) * t;
        out[o + 1] = a[1] + (b[1] - a[1]) * t;
        out[o + 2] = a[2] + (b[2] - a[2]) * t;
        out[o + 3] = 255;
      }

      function draw(): void {
        frame = requestAnimationFrame(draw);
        if (!canvas || !offCtx || !offImage) return;

        const ctx2d = canvas.getContext("2d");
        if (!ctx2d) return;

        const dpr = window.devicePixelRatio || 1;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (width === 0 || height === 0) return;

        // Both dimensions, not just the width. Opening the desk changes only
        // the height, and a stale backing store gets squashed into the new box
        // — everything drawn lands at the wrong place, most visibly the drums
        // floating above their own grid.
        const wantW = Math.round(width * dpr);
        const wantH = Math.round(height * dpr);
        if (canvas.width !== wantW || canvas.height !== wantH) {
          canvas.width = wantW;
          canvas.height = wantH;
        }

        if (painting) {
          const cell = fieldFromScreen(pointerX, pointerY);
          if (cell) {
            if (lastMark) stroke(lastMark, cell, erasing, FLOW);
            else paint(cell[0], cell[1], erasing, FLOW);
            lastMark = cell;
          }
        }

        shown.set(field);
        if (voicing) {
          const offsets = voiceOffsets(locked);
          for (let band = LEAD_FROM; band < BANDS; band++) {
            for (let col = 0; col < FIELD_W; col++) {
              const raw = field[at(col, band)];
              if (raw < SILENCE) continue;

              for (let v = 0; v < offsets.length; v++) {
                const to = band + offsets[v];
                if (to < BANDS) {
                  const i = at(col, to);
                  shown[i] = Math.min(1, shown[i] + raw * VOICE_LEVELS[v]);
                }
              }
            }
          }
        }

        for (let band = 0; band < BANDS; band++) {
          const row = (BANDS - 1 - band) * FIELD_W;
          for (let col = 0; col < FIELD_W; col++) {
            heat(shown[at(col, band)], offImage.data, (row + col) * 4);
          }
        }
        offCtx.putImageData(offImage, 0, 0);

        ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx2d.imageSmoothingEnabled = true;
        ctx2d.clearRect(0, 0, width, height);

        const scroll = Math.max(0, position());
        const px = width / FIELD_W;
        const head = FIELD_W - scroll;

        ctx2d.drawImage(off, scroll, 0, head, BANDS, 0, 0, head * px, height);
        ctx2d.drawImage(
          off,
          0,
          0,
          scroll,
          BANDS,
          head * px,
          0,
          scroll * px,
          height,
        );

        // Region boundaries, as a fraction down from the top of the canvas.
        const leadSplit = TONE_BANDS / BANDS; // lead ends, bass begins
        const percSplit = (TONE_BANDS + BASS) / BANDS; // bass ends, kit begins
        const screenX = (col: number) =>
          (((col - scroll + FIELD_W) % FIELD_W) / FIELD_W) * width;

        if (snapping) {
          for (let sub = 0; sub < SUBDIVS; sub++) {
            const swung = (sub + swingOffset(sub, swing)) * SUB_COLS;
            ctx2d.fillStyle =
              sub % 2 === 0
                ? "rgba(255,255,255,0.10)"
                : "rgba(255,255,255,0.04)";
            ctx2d.fillRect(
              screenX(swung),
              percSplit * height,
              1,
              (1 - percSplit) * height,
            );
          }
        }

        ctx2d.font = "500 11px ui-monospace, SFMono-Regular, Menlo, monospace";
        for (let bar = 0; bar < BARS; bar++) {
          const x = screenX(bar * BAR_COLS);
          ctx2d.fillStyle = "rgba(255,255,255,0.16)";
          ctx2d.fillRect(x, 0, 1, height);

          if (locked) {
            ctx2d.fillStyle = "rgba(255,255,255,0.5)";
            ctx2d.fillText(progression.bars[bar].name, x + 6, 15);
          }
        }

        ctx2d.fillStyle = "rgba(255,255,255,0.05)";
        // Two rules, so the three instruments are visibly separate territories.
        ctx2d.fillRect(0, leadSplit * height, width, 1);
        ctx2d.fillRect(0, percSplit * height, width, 1);

        // Names down the left edge, pinned to the screen rather than scrolling
        // with the loop. Without them the kit is eight anonymous stripes and
        // nobody finds the clap.
        // Abbreviated, and only when a band is tall enough to hold a line of
        // type. At ten pixels a band, full names sit on top of each other and
        // read as noise rather than as labels.
        const bandH = height / BANDS;
        if (bandH >= 9) {
          ctx2d.font = "500 8px ui-monospace, SFMono-Regular, Menlo, monospace";
          ctx2d.fillStyle = "rgba(255,255,255,0.38)";
          for (let band = 0; band < PERC; band++) {
            ctx2d.fillText(
              PERCUSSION[band].short,
              5,
              (BANDS - 1 - band) * bandH + bandH / 2 + 3,
            );
          }
          ctx2d.fillStyle = "rgba(255,255,255,0.24)";
          ctx2d.fillText("BASS", 5, TONE_BANDS * bandH + 10);
          ctx2d.fillText("LEAD", 5, 11);
        }

        const barX = BAR_FRAC * width;
        const glow = ctx2d.createLinearGradient(barX - 90, 0, barX, 0);
        glow.addColorStop(0, "rgba(255,255,255,0)");
        glow.addColorStop(1, "rgba(255,255,255,0.10)");
        ctx2d.fillStyle = glow;
        ctx2d.fillRect(barX - 90, 0, 90, height);

        ctx2d.fillStyle = "rgba(255,255,255,0.85)";
        ctx2d.fillRect(barX - 1, 0, 2, height);

        if (showCursor) {
          const bandH = height / BANDS;
          ctx2d.strokeStyle = "rgba(127,212,193,0.95)";
          ctx2d.lineWidth = 2;
          ctx2d.strokeRect(
            barX - 14,
            (BANDS - 1 - cursorBand) * bandH,
            28,
            bandH,
          );
        }
      }

      // ---- input ------------------------------------------------------------

      if (canvas) {
        canvas.addEventListener("pointerdown", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;

          const cell = fieldFromScreen(pointerX, pointerY);
          if (!cell) return;

          canvas.setPointerCapture(event.pointerId);
          painting = true;
          erasing = event.shiftKey || event.button === 2;
          showCursor = false;
          stage?.setAttribute("data-touched", "");

          start();
          paint(cell[0], cell[1], erasing, TAP);
          lastMark = cell;
        });

        canvas.addEventListener("pointermove", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;
        });

        for (const ending of ["pointerup", "pointercancel"] as const) {
          canvas.addEventListener(ending, () => {
            painting = false;
            lastMark = null;
          });
        }

        canvas.addEventListener("contextmenu", (event) => {
          event.preventDefault();
        });

        canvas.addEventListener("keydown", (event) => {
          if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            cursorBand = Math.min(
              BANDS - 1,
              Math.max(0, cursorBand + (event.key === "ArrowUp" ? 1 : -1)),
            );
            showCursor = true;
            event.preventDefault();
            return;
          }

          if (event.key === "Enter" || event.key === " ") {
            showCursor = true;
            stage?.setAttribute("data-touched", "");

            start();
            const scroll = Math.max(0, position());
            paint(
              Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W,
              cursorBand,
              event.shiftKey,
              TAP,
            );
            event.preventDefault();
          }
        });
      }

      // ---- the desk ---------------------------------------------------------

      function setSwitch(name: string, on: boolean): void {
        const button = document.querySelector<HTMLElement>(
          `[data-toggle="${name}"]`,
        );
        button?.setAttribute("aria-pressed", String(on));
      }

      function setKnob(name: string, value: number): void {
        const input = document.querySelector<HTMLInputElement>(
          `[data-knob="${name}"]`,
        );
        if (input) input.value = String(value);
      }

      function setPick(name: string, value: string): void {
        const select = document.querySelector<HTMLSelectElement>(
          `[data-pick="${name}"]`,
        );
        if (select) select.value = value;
      }

      function applyPreset(id: string): void {
        const preset = byId(PRESETS, id);

        voice = byId(VOICES, preset.voice);
        bass = byId(VOICES, preset.bass);
        vowel = byId(VOWELS, preset.vowel);
        progression = byId(PROGRESSIONS, preset.progression);
        cutoff = preset.cutoff;
        resonance = preset.resonance;
        swing = preset.swing;
        locked = preset.chords;
        voicing = preset.voicing;
        arping = preset.arp;
        setLoop(preset.loop);

        setPick("voice", preset.voice);
        setPick("bass", preset.bass);
        setPick("vowel", preset.vowel);
        setPick("progression", preset.progression);
        setPick("groove", preset.groove);
        setKnob("cutoff", preset.cutoff);
        setKnob("resonance", preset.resonance);
        setKnob("swing", preset.swing);
        setKnob("loop", preset.loop);
        setSwitch("chords", preset.chords);
        setSwitch("voice", preset.voicing);
        setSwitch("arp", preset.arp);

        for (const button of document.querySelectorAll("[data-preset]")) {
          button.setAttribute(
            "aria-pressed",
            String(button.getAttribute("data-preset") === id),
          );
        }

        applyVoice();
        applyVowel();
        applyFilter();
        hushVoices();
        stampGroove(preset.groove);
        tunedTo = -1;
      }

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-preset]",
      )) {
        button.addEventListener("click", () => {
          stage?.setAttribute("data-touched", "");
          start();
          applyPreset(button.dataset.preset ?? "");
        });
      }

      document
        .querySelector<HTMLElement>("[data-clear]")
        ?.addEventListener("click", () => {
          field.fill(0);
          hushVoices();
        });

      for (const select of document.querySelectorAll<HTMLSelectElement>(
        "[data-pick]",
      )) {
        select.addEventListener("change", () => {
          switch (select.dataset.pick) {
            case "voice":
              voice = byId(VOICES, select.value);
              applyVoice();
              break;
            case "bass":
              bass = byId(VOICES, select.value);
              applyVoice();
              break;
            case "vowel":
              vowel = byId(VOWELS, select.value);
              applyVowel();
              break;
            case "progression":
              progression = byId(PROGRESSIONS, select.value);
              tunedTo = -1;
              break;
            case "scale":
              scale = byId(SCALES, select.value);
              tunedTo = -1;
              break;
          }
        });
      }

      for (const input of document.querySelectorAll<HTMLInputElement>(
        "[data-knob]",
      )) {
        input.addEventListener("input", () => {
          const value = Number(input.value);
          switch (input.dataset.knob) {
            case "cutoff":
              cutoff = value;
              applyFilter();
              break;
            case "resonance":
              resonance = value;
              applyFilter();
              break;
            case "swing":
              swing = value;
              break;
            default:
              setLoop(value);
          }
        });
      }

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-toggle]",
      )) {
        button.addEventListener("click", () => {
          const on = button.getAttribute("aria-pressed") !== "true";
          button.setAttribute("aria-pressed", String(on));

          switch (button.dataset.toggle) {
            case "chords":
              locked = on;
              tunedTo = -1;
              break;
            case "voice":
              voicing = on;
              break;
            case "arp":
              arping = on;
              hushVoices();
              break;
            default:
              snapping = on;
          }
        });
      }

      // ---- continuation -----------------------------------------------------

      const status = document.querySelector<HTMLElement>("[data-status]");
      let thinking = false;

      function say(message: string): void {
        if (status) status.textContent = message;
      }

      // Where a step of the loop lives. This has to be the same place the grid
      // snaps to, not the middle of the gap after it: the brush is narrower
      // than a subdivision, so reading half a subdivision late looks just past
      // every mark and reports an empty loop.
      const colOfStep = (step: number) =>
        (Math.round(step * SUB_COLS) + FIELD_W) % FIELD_W;

      // The loudest thing anywhere in a step's window. Marks drawn by hand do
      // not land on the grid, and swing moves the snapped ones off it, so a
      // single-column probe would miss most of what is actually there.
      function levelAt(step: number, band: number): number {
        const centre = colOfStep(step);
        const reach = Math.floor(SUB_COLS / 2);
        let best = 0;

        for (let d = -reach; d <= reach; d++) {
          const level = field[at((centre + d + FIELD_W) % FIELD_W, band)];
          if (level > best) best = level;
        }
        return best;
      }

      // Reads the drawing back out as notes. The models are monophonic for
      // melody, so where a column holds a stack only its loudest band is taken.
      function readMelody(): { notes: Note[] } {
        const notes: Note[] = [];
        let open: Note | null = null;

        for (let step = 0; step < SUBDIVS; step++) {
          const col = colOfStep(step);
          let best = -1;
          let bestLevel = SILENCE;

          for (let i = 0; i < TONE_BANDS; i++) {
            const level = levelAt(step, LEAD_FROM + i);
            if (level > bestLevel) {
              bestLevel = level;
              best = i;
            }
          }

          if (best < 0) {
            open = null;
            continue;
          }

          const pitch =
            KEY_MIDI + semitoneOf(best, tonesFor(chordAt(col)));

          // A pitch that carries on is one note, not one per step.
          if (open && open.pitch === pitch && open.step + open.steps === step) {
            open.steps += 1;
          } else {
            open = { step, steps: 1, pitch };
            notes.push(open);
          }
        }
        return { notes };
      }

      function readDrums(): { beats: Beat[] } {
        const beats: Beat[] = [];

        for (let step = 0; step < SUBDIVS; step++) {
          for (let band = 0; band < PERC; band++) {
            if (levelAt(step, band) >= ONSET) {
              beats.push({ step, band });
            }
          }
        }
        return { beats };
      }

      function eraseFrom(step: number, lowBand: number, highBand: number) {
        for (let s = step; s < SUBDIVS; s++) {
          const centre = colOfStep(s);
          for (let d = -Math.ceil(SUB_COLS / 2); d <= SUB_COLS / 2; d++) {
            const col = (centre + d + FIELD_W) % FIELD_W;
            for (let band = lowBand; band < highBand; band++) {
              field[at(col, band)] = 0;
            }
          }
        }
      }

      // Call and response: the front half of the loop is the prompt, the back
      // half is what the model answers with. Fixed rather than "wherever the
      // drawing happens to stop", because that left it as few as seven steps
      // to work with and the answer came back empty.
      const HANDOVER = Math.floor(SUBDIVS / 2);

      async function suggest(kind: string): Promise<void> {
        if (thinking) return;
        thinking = true;

        try {
          start();
          const base = import.meta.env.BASE_URL;

          if (kind === "melody") {
            const { notes } = readMelody();
            if (notes.length === 0) {
              say("draw a few notes first");
              return;
            }

            const from = HANDOVER;
            const chords: string[] = [];
            for (let step = from; step < SUBDIVS; step++) {
              chords.push(progression.bars[chordAt(colOfStep(step))].symbol);
            }

            say("thinking…");
            const seed = notes.filter((note) => note.step < from);
            const grown = await continueMelody(
              base,
              seed.length > 0 ? seed : notes,
              chords,
              from,
              1.1,
            );

            eraseFrom(from, LEAD_FROM, BANDS);

            // Back into the field by pitch, snapped to the nearest band so the
            // model can only ever land somewhere the instrument can play.
            for (const note of grown) {
              const tones = tonesFor(chordAt(colOfStep(note.step)));
              let band = 0;
              let closest = Infinity;
              for (let i = 0; i < TONE_BANDS; i++) {
                const gap = Math.abs(
                  KEY_MIDI + semitoneOf(i, tones) - note.pitch,
                );
                if (gap < closest) {
                  closest = gap;
                  band = i;
                }
              }
              for (let s = 0; s < note.steps; s++) {
                const step = note.step + s;
                if (step >= SUBDIVS) break;
                paint(colOfStep(step), LEAD_FROM + band, false, 0.7);
              }
            }
            say(grown.length > 0 ? `${grown.length} notes` : "nothing came back");
            return;
          }

          const { beats } = readDrums();
          if (beats.length === 0) {
            say("draw some drums first");
            return;
          }

          const from = HANDOVER;
          say("thinking…");
          const grown = await continueDrums(
            base,
            beats.filter((beat) => beat.step < from),
            drumMidi(),
            from,
            SUBDIVS - from,
            1.05,
          );

          eraseFrom(from, 0, PERC);
          let placed = 0;
          for (const hit of grown) {
            const band = bandForDrumMidi(hit.pitch);
            if (band === null || hit.step >= SUBDIVS) continue;
            paint(colOfStep(hit.step), band, false, 0.8);
            placed++;
          }
          say(placed > 0 ? `${placed} hits` : "nothing came back");
        } catch (error) {
          // Frozen library, vendored weights: if any of it gives up, the
          // instrument must not.
          say("the model did not load");
          console.error(error);
        } finally {
          thinking = false;
        }
      }

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-continue]",
      )) {
        button.addEventListener("click", () => {
          stage?.setAttribute("data-touched", "");
          void suggest(button.dataset.continue ?? "");
        });
      }

      // Plugging things in. Each bank writes one region, so a beat, a bass
      // line and a phrase stack rather than overwrite one another.
      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-groove]",
      )) {
        button.addEventListener("click", () => {
          stage?.setAttribute("data-touched", "");
          start();
          stampGroove(button.dataset.groove ?? "");
        });
      }

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-bassline]",
      )) {
        button.addEventListener("click", () => {
          stage?.setAttribute("data-touched", "");
          start();
          stampPhrase(
            byId(BASS_LINES, button.dataset.bassline ?? "").notes,
            BASS_FROM,
            BASS,
          );
        });
      }

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-phrase]",
      )) {
        button.addEventListener("click", () => {
          stage?.setAttribute("data-touched", "");
          start();
          stampPhrase(
            byId(PHRASES, button.dataset.phrase ?? "").notes,
            LEAD_FROM,
            TONE_BANDS,
          );
        });
      }

      // The kit on the keyboard. Listened for on the window rather than the
      // canvas: a pad you have to click into first is not a pad. A press
      // sounds immediately and writes itself at the play bar, quantised like
      // any other drum — which is what a drum machine does when you record.
      window.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) {
          return;
        }
        const target = event.target as HTMLElement | null;
        if (target && /^(INPUT|SELECT|TEXTAREA|BUTTON)$/.test(target.tagName)) {
          return;
        }

        const band = DRUM_KEYS.indexOf(event.key.toLowerCase());
        if (band < 0) return;
        event.preventDefault();

        stage?.setAttribute("data-touched", "");
        const active = start();

        drum(active, band, active.ctx.currentTime, 0.85);

        const scroll = Math.max(0, position());
        paint(
          Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W,
          band,
          false,
          TAP,
        );

        // It has already sounded, so stop the bar from playing it a second
        // time as it crosses the mark that was just written.
        lastDrum[band] = 1;
      });

      draw();

      // Without this, every hot reload in development leaves the previous
      // module's oscillators and interval running — the page keeps playing a
      // drawing that is no longer on screen.
      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          if (audioTimer !== undefined) window.clearInterval(audioTimer);
          if (frame !== undefined) cancelAnimationFrame(frame);
          void audio?.ctx.close();
          audio = null;
        });
      }
    </script>
  </body>
</html>
