---
import "../styles/global.css";
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carousel</title>
    <meta
      name="description"
      content="Draw a spectrogram and hear it. The loop scrolls into a play bar over a chord progression — low is drums, high is notes, and every mark lands in key."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL}>Home</a>
      </nav>
    </header>

    <main>
      <section data-stage>
        <canvas
          data-grid
          tabindex="0"
          role="application"
          aria-label="Drawing loop. Drag to paint sound. Up and down arrows choose a pitch, Enter paints it at the play bar."
        ></canvas>
        <div data-invitation>
          <h1>Draw to play</h1>
          <p data-testid="intro">Low is drums, high is notes.</p>
        </div>
      </section>

      <div data-controls>
        <button type="button" data-clear>Clear</button>
        <button type="button" data-toggle="chords" aria-pressed="true">
          Chords
        </button>
        <button type="button" data-toggle="voice" aria-pressed="true">
          Voicing
        </button>
        <button type="button" data-toggle="arp" aria-pressed="false">Arp</button>
        <button type="button" data-toggle="snap" aria-pressed="true">
          Snap
        </button>
        <p data-hint>Hold shift to rub out.</p>
      </div>
    </main>

    <script>
      const canvas = document.querySelector<HTMLCanvasElement>("[data-grid]");
      const stage = document.querySelector<HTMLElement>("[data-stage]");
      const clearButton = document.querySelector<HTMLElement>("[data-clear]");

      // The loop is a field of intensities: FIELD_W slices of time by BANDS of
      // pitch. Deliberately much finer than a step sequencer's grid — nothing
      // about a drawn note's length or loudness is quantised.
      const FIELD_W = 512;
      const BANDS = 20;
      const DRUM_BANDS = 4; // bottom up: kick, tom, snare, hat
      const TONE_BANDS = BANDS - DRUM_BANDS;

      const LOOP_S = 6;
      const BAR_FRAC = 0.18; // the play bar, as a fraction of the width

      // Structure. Four bars to the loop, eight subdivisions to the bar, so
      // drums can be placed to a thirty-second of the loop.
      const BARS = 4;
      const SUBDIVS = BARS * 8;
      const SUB_COLS = FIELD_W / SUBDIVS;
      const BAR_COLS = FIELD_W / BARS;

      // A minor, and a progression that never leaves it. Sevenths rather than
      // triads: four notes fill the bands evenly and the extra tone is what
      // makes a held chord sound considered rather than plain.
      const KEY_HZ = 110; // A2
      const MINOR = [0, 2, 3, 5, 7, 8, 10];
      const PROGRESSION = [
        { name: "Am7", tones: [0, 3, 7, 10] },
        { name: "Fmaj7", tones: [8, 12, 15, 19] },
        { name: "Cmaj7", tones: [3, 7, 10, 14] },
        { name: "G7", tones: [10, 14, 17, 20] },
      ];

      // Voicing a single mark as a chord. In chord mode the neighbouring bands
      // are already the next chord tones, so +1 and +2 build the real chord.
      // In scale mode the same job needs a diatonic third and fifth, which is
      // +2 and +4 scale degrees.
      const VOICE_LEVELS = [0.5, 0.32];

      const BRUSH_X = 7;
      const BRUSH_Y = 1.3;
      const TAP = 0.45;
      const FLOW = 0.09;

      const ONSET = 0.18;
      const AUDIO_TICK_MS = 10;

      // Below this a mark is too faint to see against the background, so it
      // must not be able to make a sound either.
      const SILENCE = 0.04;

      const field = new Float32Array(FIELD_W * BANDS);
      const targets = new Float32Array(TONE_BANDS);
      const shown = new Float32Array(FIELD_W * BANDS);

      let harmonise = true; // bands locked to the progression
      let voicing = true; // one mark sounds as a chord
      let arping = false; // chords read out a tone at a time
      let snapping = true; // drums magnetise to the grid

      type Voice = { osc: OscillatorNode; gain: GainNode };
      type Audio = {
        ctx: AudioContext;
        master: GainNode;
        noise: AudioBuffer;
        voices: Voice[];
        startedAt: number;
      };

      let audio: Audio | null = null;
      let audioTimer: number | undefined;
      let frame: number | undefined;

      let painting = false;
      let erasing = false;
      let pointerX = 0;
      let pointerY = 0;
      let lastMark: [number, number] | null = null;
      let cursorBand = DRUM_BANDS + 4;
      let showCursor = false;

      let tunedTo = -1;
      let lastSub = -1;
      let arpStep = 0;
      const lastDrum = new Float32Array(DRUM_BANDS);

      const off = document.createElement("canvas");
      off.width = FIELD_W;
      off.height = BANDS;
      const offCtx = off.getContext("2d");
      const offImage = offCtx?.createImageData(FIELD_W, BANDS);

      function at(col: number, band: number): number {
        return band * FIELD_W + col;
      }

      // ---- the musical layout ------------------------------------------------

      // Which chord is in force at a given column of the loop.
      function chordAt(col: number): number {
        return Math.floor(col / BAR_COLS) % BARS;
      }

      // Where a band sits, in semitones above the key. With the progression
      // locked in, consecutive bands are consecutive chord tones, so the whole
      // keyboard moves with the harmony. Unlocked, they are scale degrees.
      function semitoneOf(index: number, chord: number): number {
        if (harmonise) {
          const tones = PROGRESSION[chord].tones;
          return tones[index % 4] + 12 * Math.floor(index / 4);
        }
        return MINOR[index % 7] + 12 * Math.floor(index / 7);
      }

      // The two bands that voice a mark as a chord.
      function voiceOffsets(): [number, number] {
        return harmonise ? [1, 2] : [2, 4];
      }

      // ---- sound ------------------------------------------------------------

      function makeNoise(ctx: AudioContext): AudioBuffer {
        const buffer = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        return buffer;
      }

      function ensureAudio(): Audio {
        if (audio) return audio;

        const ctx = new AudioContext();
        const master = ctx.createGain();

        const squash = ctx.createDynamicsCompressor();
        squash.threshold.value = -20;
        squash.ratio.value = 10;

        master.gain.value = 0.9;
        master.connect(squash).connect(ctx.destination);

        const voices: Voice[] = [];
        for (let i = 0; i < TONE_BANDS; i++) {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = "triangle";
          osc.frequency.value = KEY_HZ * 2 ** (semitoneOf(i, 0) / 12);
          gain.gain.value = 0;

          osc.connect(gain).connect(master);
          osc.start();
          voices.push({ osc, gain });
        }

        audio = { ctx, master, noise: makeNoise(ctx), voices, startedAt: 0 };
        return audio;
      }

      function envelope(
        active: Audio,
        when: number,
        peak: number,
        decay: number,
      ): GainNode {
        const gain = active.ctx.createGain();
        gain.gain.setValueAtTime(0, when);
        gain.gain.linearRampToValueAtTime(peak, when + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, when + decay);
        gain.connect(active.master);
        return gain;
      }

      function burst(
        active: Audio,
        when: number,
        type: BiquadFilterType,
        frequency: number,
        peak: number,
        decay: number,
      ): void {
        const source = active.ctx.createBufferSource();
        const filter = active.ctx.createBiquadFilter();

        source.buffer = active.noise;
        filter.type = type;
        filter.frequency.value = frequency;

        source.connect(filter).connect(envelope(active, when, peak, decay));
        source.start(when);
        source.stop(when + decay + 0.02);
      }

      function swept(
        active: Audio,
        when: number,
        from: number,
        to: number,
        bend: number,
        peak: number,
        decay: number,
      ): void {
        const osc = active.ctx.createOscillator();
        osc.type = "sine";
        osc.frequency.setValueAtTime(from, when);
        osc.frequency.exponentialRampToValueAtTime(to, when + bend);
        osc.connect(envelope(active, when, peak, decay));
        osc.start(when);
        osc.stop(when + decay + 0.04);
      }

      // Four drums that should never be mistaken for one another: a deep thud
      // with a click on the front, a hollow pitched boom, a crack with a body
      // tone under the noise, and a tick short enough to read as metal.
      function drum(active: Audio, band: number, when: number, level: number) {
        if (band === 0) {
          swept(active, when, 160, 45, 0.1, level * 0.95, 0.3);
          burst(active, when, "highpass", 3000, level * 0.18, 0.015);
        } else if (band === 1) {
          swept(active, when, 260, 110, 0.18, level * 0.7, 0.34);
        } else if (band === 2) {
          burst(active, when, "bandpass", 1800, level * 0.5, 0.16);
          swept(active, when, 190, 170, 0.1, level * 0.3, 0.11);
        } else {
          burst(active, when, "highpass", 9000, level * 0.32, 0.028);
        }
      }

      function pluck(gain: GainNode, level: number, now: number): void {
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(Math.max(0.0001, gain.gain.value), now);
        gain.gain.linearRampToValueAtTime(level * level * 0.17, now + 0.006);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);
      }

      function position(): number {
        if (!audio || audioTimer === undefined) return -1;
        const elapsed = audio.ctx.currentTime - audio.startedAt;
        if (elapsed < 0) return 0;
        return ((elapsed / LOOP_S) * FIELD_W) % FIELD_W;
      }

      // Retunes the whole bank when the progression moves on. A note held
      // across a bar line changes pitch to stay a chord tone, which is the
      // voice leading a player would do by hand.
      function retune(active: Audio, chord: number, now: number): void {
        if (chord === tunedTo) return;
        tunedTo = chord;

        for (let i = 0; i < active.voices.length; i++) {
          active.voices[i].osc.frequency.setTargetAtTime(
            KEY_HZ * 2 ** (semitoneOf(i, chord) / 12),
            now,
            0.02,
          );
        }
      }

      function listen(): void {
        const active = audio;
        if (!active) return;

        const scroll = position();
        if (scroll < 0) return;

        const col = Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W;
        const now = active.ctx.currentTime;

        retune(active, chordAt(col), now);

        // Gather what the bar is sitting on, voicing each mark as a chord
        // before anything reaches a gain, so the harmony notes mix with
        // whatever else is drawn there rather than stacking on top of it.
        targets.fill(0);
        for (let i = 0; i < TONE_BANDS; i++) {
          const raw = field[at(col, DRUM_BANDS + i)];
          if (raw < SILENCE) continue;

          targets[i] = Math.min(1, targets[i] + raw);
          if (!voicing) continue;

          const offsets = voiceOffsets();
          for (let v = 0; v < offsets.length; v++) {
            const to = i + offsets[v];
            if (to < TONE_BANDS) {
              targets[to] = Math.min(1, targets[to] + raw * VOICE_LEVELS[v]);
            }
          }
        }

        const sub = Math.floor(col / SUB_COLS);
        const crossed = sub !== lastSub;
        lastSub = sub;

        if (arping) {
          // One tone per subdivision, cycling up through whatever is drawn.
          // Notes left behind ring on rather than being cut, so the arpeggio
          // overlaps itself the way a real one does.
          if (crossed) {
            const live: number[] = [];
            for (let i = 0; i < TONE_BANDS; i++) {
              if (targets[i] > 0) live.push(i);
            }

            if (live.length > 0) {
              const pick = live[arpStep % live.length];
              arpStep++;
              pluck(active.voices[pick].gain, targets[pick], now);
            } else {
              arpStep = 0;
            }
          }
        } else {
          for (let i = 0; i < TONE_BANDS; i++) {
            active.voices[i].gain.gain.setTargetAtTime(
              targets[i] * targets[i] * 0.13,
              now,
              0.04,
            );
          }
        }

        for (let band = 0; band < DRUM_BANDS; band++) {
          const raw = field[at(col, band)];
          const level = raw < SILENCE ? 0 : raw;
          if (level >= ONSET && lastDrum[band] < ONSET) {
            drum(active, band, now, level);
          }
          lastDrum[band] = level;
        }
      }

      function silenceVoices(): void {
        if (!audio) return;
        const now = audio.ctx.currentTime;
        for (const voice of audio.voices) {
          voice.gain.gain.cancelScheduledValues(now);
          voice.gain.gain.setTargetAtTime(0, now, 0.05);
        }
      }

      function start(): Audio {
        const active = ensureAudio();
        if (active.ctx.state === "suspended") void active.ctx.resume();

        if (audioTimer === undefined) {
          active.startedAt = active.ctx.currentTime;
          stage?.setAttribute("data-live", "");
          audioTimer = window.setInterval(listen, AUDIO_TICK_MS);
        }
        return active;
      }

      // ---- painting ---------------------------------------------------------

      function paint(
        col: number,
        band: number,
        wipe: boolean,
        amount: number,
      ): void {
        // Drums land on the grid, notes land where they were drawn. Rubbing
        // out is never snapped, or a stray hit would be unerasable.
        if (snapping && !wipe && band < DRUM_BANDS) {
          col = (Math.round(col / SUB_COLS) * SUB_COLS) % FIELD_W;
        }

        const reachX = Math.ceil(BRUSH_X);
        const reachY = Math.ceil(BRUSH_Y);

        for (let dy = -reachY; dy <= reachY; dy++) {
          const y = band + dy;
          if (y < 0 || y >= BANDS) continue;

          for (let dx = -reachX; dx <= reachX; dx++) {
            const falloff = 1 - Math.hypot(dx / BRUSH_X, dy / BRUSH_Y);
            if (falloff <= 0) continue;

            const x = (col + dx + FIELD_W) % FIELD_W;
            const i = at(x, y);
            const add = amount * falloff;

            if (wipe) {
              const next = field[i] - add * 2.5;
              field[i] = next < SILENCE ? 0 : next;
            } else {
              field[i] = Math.min(1, field[i] + add);
            }
          }
        }
      }

      // A pointer reports where it is, not the path it took, so a quick drag
      // arrives as a handful of far-apart samples. Stamping along the line
      // between the last mark and this one keeps a fast gesture a line.
      function stroke(
        from: [number, number],
        to: [number, number],
        wipe: boolean,
        amount: number,
      ): void {
        let dx = to[0] - from[0];
        if (dx > FIELD_W / 2) dx -= FIELD_W;
        if (dx < -FIELD_W / 2) dx += FIELD_W;
        const dy = to[1] - from[1];

        const steps = Math.max(
          1,
          Math.ceil(Math.max(Math.abs(dx) / 2, Math.abs(dy) * 2)),
        );

        for (let i = 1; i <= steps; i++) {
          const t = i / steps;
          paint(
            Math.round(from[0] + dx * t + FIELD_W) % FIELD_W,
            Math.round(from[1] + dy * t),
            wipe,
            amount,
          );
        }
      }

      function fieldFromScreen(
        clientX: number,
        clientY: number,
      ): [number, number] | null {
        if (!canvas) return null;

        const box = canvas.getBoundingClientRect();
        const fx = (clientX - box.left) / box.width;
        const fy = (clientY - box.top) / box.height;
        if (fx < 0 || fx > 1 || fy < 0 || fy > 1) return null;

        const scroll = Math.max(0, position());
        const col = Math.floor(scroll + fx * FIELD_W) % FIELD_W;
        const band = BANDS - 1 - Math.floor(fy * BANDS);
        return [col, Math.min(BANDS - 1, Math.max(0, band))];
      }

      // ---- drawing ----------------------------------------------------------

      const HEAT: [number, number, number][] = [
        [10, 12, 22],
        [40, 25, 92],
        [128, 38, 130],
        [220, 74, 96],
        [246, 150, 60],
        [255, 240, 170],
      ];

      function heat(level: number, out: Uint8ClampedArray, o: number): void {
        const scaled = Math.min(0.999, Math.max(0, level)) * (HEAT.length - 1);
        const i = Math.floor(scaled);
        const t = scaled - i;
        const a = HEAT[i];
        const b = HEAT[Math.min(HEAT.length - 1, i + 1)];

        out[o] = a[0] + (b[0] - a[0]) * t;
        out[o + 1] = a[1] + (b[1] - a[1]) * t;
        out[o + 2] = a[2] + (b[2] - a[2]) * t;
        out[o + 3] = 255;
      }

      function draw(): void {
        frame = requestAnimationFrame(draw);
        if (!canvas || !offCtx || !offImage) return;

        const ctx2d = canvas.getContext("2d");
        if (!ctx2d) return;

        const dpr = window.devicePixelRatio || 1;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (width === 0 || height === 0) return;

        if (canvas.width !== Math.round(width * dpr)) {
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
        }

        if (painting) {
          const cell = fieldFromScreen(pointerX, pointerY);
          if (cell) {
            if (lastMark) stroke(lastMark, cell, erasing, FLOW);
            else paint(cell[0], cell[1], erasing, FLOW);
            lastMark = cell;
          }
        }

        // The display carries the voiced chord as well as the drawn mark, so
        // nothing is audible without being visible — and parallel bands above
        // a note is what a spectrogram of a real instrument looks like.
        shown.set(field);
        if (voicing) {
          const offsets = voiceOffsets();
          for (let band = DRUM_BANDS; band < BANDS; band++) {
            for (let col = 0; col < FIELD_W; col++) {
              const raw = field[at(col, band)];
              if (raw < SILENCE) continue;

              for (let v = 0; v < offsets.length; v++) {
                const to = band + offsets[v];
                if (to < BANDS) {
                  const i = at(col, to);
                  shown[i] = Math.min(1, shown[i] + raw * VOICE_LEVELS[v]);
                }
              }
            }
          }
        }

        for (let band = 0; band < BANDS; band++) {
          const row = (BANDS - 1 - band) * FIELD_W;
          for (let col = 0; col < FIELD_W; col++) {
            heat(shown[at(col, band)], offImage.data, (row + col) * 4);
          }
        }
        offCtx.putImageData(offImage, 0, 0);

        ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx2d.imageSmoothingEnabled = true;
        ctx2d.clearRect(0, 0, width, height);

        const scroll = Math.max(0, position());
        const px = width / FIELD_W;
        const head = FIELD_W - scroll;

        ctx2d.drawImage(off, scroll, 0, head, BANDS, 0, 0, head * px, height);
        ctx2d.drawImage(
          off,
          0,
          0,
          scroll,
          BANDS,
          head * px,
          0,
          scroll * px,
          height,
        );

        const split = (BANDS - DRUM_BANDS) / BANDS;
        const screenX = (col: number) =>
          (((col - scroll + FIELD_W) % FIELD_W) / FIELD_W) * width;

        // The subdivision grid lives in the drum band, where snapping applies.
        if (snapping) {
          for (let sub = 0; sub < SUBDIVS; sub++) {
            ctx2d.fillStyle =
              sub % 2 === 0
                ? "rgba(255,255,255,0.10)"
                : "rgba(255,255,255,0.04)";
            ctx2d.fillRect(
              screenX(sub * SUB_COLS),
              split * height,
              1,
              (1 - split) * height,
            );
          }
        }

        // Bar lines and their chord names run the full height: this is the
        // song's structure, and a player should be able to see where the
        // harmony turns over before they draw into it.
        ctx2d.font =
          "500 11px ui-monospace, SFMono-Regular, Menlo, monospace";
        for (let bar = 0; bar < BARS; bar++) {
          const x = screenX(bar * BAR_COLS);
          ctx2d.fillStyle = "rgba(255,255,255,0.16)";
          ctx2d.fillRect(x, 0, 1, height);

          if (harmonise) {
            ctx2d.fillStyle = "rgba(255,255,255,0.5)";
            ctx2d.fillText(PROGRESSION[bar].name, x + 6, 15);
          }
        }

        ctx2d.fillStyle = "rgba(255,255,255,0.05)";
        ctx2d.fillRect(0, split * height, width, 1);

        const barX = BAR_FRAC * width;
        const glow = ctx2d.createLinearGradient(barX - 90, 0, barX, 0);
        glow.addColorStop(0, "rgba(255,255,255,0)");
        glow.addColorStop(1, "rgba(255,255,255,0.10)");
        ctx2d.fillStyle = glow;
        ctx2d.fillRect(barX - 90, 0, 90, height);

        ctx2d.fillStyle = "rgba(255,255,255,0.85)";
        ctx2d.fillRect(barX - 1, 0, 2, height);

        if (showCursor) {
          const bandH = height / BANDS;
          ctx2d.strokeStyle = "rgba(127,212,193,0.95)";
          ctx2d.lineWidth = 2;
          ctx2d.strokeRect(
            barX - 14,
            (BANDS - 1 - cursorBand) * bandH,
            28,
            bandH,
          );
        }
      }

      // ---- input ------------------------------------------------------------

      if (canvas) {
        canvas.addEventListener("pointerdown", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;

          const cell = fieldFromScreen(pointerX, pointerY);
          if (!cell) return;

          canvas.setPointerCapture(event.pointerId);
          painting = true;
          erasing = event.shiftKey || event.button === 2;
          showCursor = false;
          stage?.setAttribute("data-touched", "");

          start();
          paint(cell[0], cell[1], erasing, TAP);
          lastMark = cell;
        });

        // Only records where the pointer is. The painting happens in the frame
        // loop, because the field scrolls underneath a held brush and no
        // pointer event fires while the pointer is not moving.
        canvas.addEventListener("pointermove", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;
        });

        for (const ending of ["pointerup", "pointercancel"] as const) {
          canvas.addEventListener(ending, () => {
            painting = false;
            lastMark = null;
          });
        }

        canvas.addEventListener("contextmenu", (event) => {
          event.preventDefault();
        });

        canvas.addEventListener("keydown", (event) => {
          if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            cursorBand = Math.min(
              BANDS - 1,
              Math.max(0, cursorBand + (event.key === "ArrowUp" ? 1 : -1)),
            );
            showCursor = true;
            event.preventDefault();
            return;
          }

          if (event.key === "Enter" || event.key === " ") {
            showCursor = true;
            stage?.setAttribute("data-touched", "");

            start();
            const scroll = Math.max(0, position());
            paint(
              Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W,
              cursorBand,
              event.shiftKey,
              TAP,
            );
            event.preventDefault();
          }
        });
      }

      clearButton?.addEventListener("click", () => {
        field.fill(0);
      });

      for (const button of document.querySelectorAll<HTMLElement>(
        "[data-toggle]",
      )) {
        button.addEventListener("click", () => {
          const on = button.getAttribute("aria-pressed") !== "true";
          button.setAttribute("aria-pressed", String(on));

          switch (button.dataset.toggle) {
            case "chords":
              harmonise = on;
              tunedTo = -1; // the whole bank needs retuning to the new layout
              break;
            case "voice":
              voicing = on;
              break;
            case "arp":
              arping = on;
              silenceVoices(); // sustains and plucks drive the gains differently
              break;
            default:
              snapping = on;
          }
        });
      }

      draw();

      // Without this, every hot reload in development leaves the previous
      // module's oscillators and interval running — the page keeps playing a
      // drawing that is no longer on screen.
      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          if (audioTimer !== undefined) window.clearInterval(audioTimer);
          if (frame !== undefined) cancelAnimationFrame(frame);
          void audio?.ctx.close();
          audio = null;
        });
      }
    </script>
  </body>
</html>
