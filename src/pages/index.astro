---
import "../styles/global.css";
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carousel</title>
    <meta
      name="description"
      content="Draw a spectrogram and hear it. The loop scrolls left into a play bar, sounding whatever you painted — low is drums, high is notes, and it comes round again."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL}>Home</a>
      </nav>
    </header>

    <main>
      <section data-stage>
        <canvas
          data-grid
          tabindex="0"
          role="application"
          aria-label="Drawing loop. Drag to paint sound. Up and down arrows choose a pitch, Enter paints it at the play bar."
        ></canvas>
        <div data-invitation>
          <h1>Draw to play</h1>
          <p data-testid="intro">Low is drums, high is notes.</p>
        </div>
      </section>

      <div data-controls>
        <button type="button" data-clear>Clear</button>
        <p data-hint>Hold shift to rub out.</p>
      </div>
    </main>

    <script>
      const canvas = document.querySelector<HTMLCanvasElement>("[data-grid]");
      const stage = document.querySelector<HTMLElement>("[data-stage]");
      const clearButton = document.querySelector<HTMLElement>("[data-clear]");

      // The loop is a field of intensities: FIELD_W slices of time by BANDS of
      // pitch. It is deliberately much finer than a step sequencer's grid —
      // nothing is quantised, so a stroke lands where it was drawn and a note
      // is however long you drew it.
      const FIELD_W = 512;
      const BANDS = 24;
      const DRUM_BANDS = 3; // lowest three: kick, snare, hat
      const TONE_BANDS = BANDS - DRUM_BANDS;

      const LOOP_S = 6;
      const BAR_FRAC = 0.18; // the play bar, as a fraction of the width

      const ROOT_HZ = 110;
      const PENTATONIC = [0, 3, 5, 7, 10];

      // The brush, in field units. Wide in time and narrow in pitch, so a
      // sideways drag draws a line rather than a smear across the scale.
      const BRUSH_X = 7;
      const BRUSH_Y = 1.3;
      const TAP = 0.45; // one deliberate press
      const FLOW = 0.09; // added each frame the brush is held down

      const ONSET = 0.18; // a drum fires when its band crosses this at the bar
      const AUDIO_TICK_MS = 10;

      const HEAT: [number, number, number][] = [
        [10, 12, 22],
        [40, 25, 92],
        [128, 38, 130],
        [220, 74, 96],
        [246, 150, 60],
        [255, 240, 170],
      ];

      const field = new Float32Array(FIELD_W * BANDS);

      type Voice = { osc: OscillatorNode; gain: GainNode };
      type Audio = {
        ctx: AudioContext;
        master: GainNode;
        noise: AudioBuffer;
        voices: Voice[];
        startedAt: number;
      };

      let audio: Audio | null = null;
      let audioTimer: number | undefined;
      let frame: number | undefined;

      let painting = false;
      let erasing = false;
      let pointerX = 0;
      let pointerY = 0;
      let lastMark: [number, number] | null = null;
      let cursorBand = DRUM_BANDS + 4;
      let showCursor = false;

      const lastDrum = new Float32Array(DRUM_BANDS);

      // The offscreen field, one pixel per cell. Scaling this up with smoothing
      // on is what makes the display read as a continuous spectrogram rather
      // than a grid of tiles.
      const off = document.createElement("canvas");
      off.width = FIELD_W;
      off.height = BANDS;
      const offCtx = off.getContext("2d");
      const offImage = offCtx?.createImageData(FIELD_W, BANDS);

      function at(col: number, band: number): number {
        return band * FIELD_W + col;
      }

      // ---- sound ------------------------------------------------------------

      function pitchOf(band: number): number {
        const step = band - DRUM_BANDS;
        const semitones =
          Math.floor(step / PENTATONIC.length) * 12 +
          PENTATONIC[step % PENTATONIC.length];
        return ROOT_HZ * 2 ** (semitones / 12);
      }

      function makeNoise(ctx: AudioContext): AudioBuffer {
        const buffer = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        return buffer;
      }

      function ensureAudio(): Audio {
        if (audio) return audio;

        const ctx = new AudioContext();
        const master = ctx.createGain();

        // Painting everywhere should get loud and thick, never clipped — one
        // of the ways "there is no way to play it wrong" is kept true.
        const squash = ctx.createDynamicsCompressor();
        squash.threshold.value = -20;
        squash.ratio.value = 10;

        master.gain.value = 0.9;
        master.connect(squash).connect(ctx.destination);

        // One oscillator per pitch band, running for the life of the page.
        // Notes are made by moving these gains, not by starting and stopping
        // voices — that is what makes the result continuous.
        const voices: Voice[] = [];
        for (let band = DRUM_BANDS; band < BANDS; band++) {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = "triangle";
          osc.frequency.value = pitchOf(band);
          gain.gain.value = 0;

          osc.connect(gain).connect(master);
          osc.start();
          voices.push({ osc, gain });
        }

        audio = { ctx, master, noise: makeNoise(ctx), voices, startedAt: 0 };
        return audio;
      }

      function envelope(
        active: Audio,
        when: number,
        peak: number,
        decay: number,
      ): GainNode {
        const gain = active.ctx.createGain();
        gain.gain.setValueAtTime(0, when);
        gain.gain.linearRampToValueAtTime(peak, when + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, when + decay);
        gain.connect(active.master);
        return gain;
      }

      function burst(
        active: Audio,
        when: number,
        type: BiquadFilterType,
        frequency: number,
        peak: number,
        decay: number,
      ): void {
        const source = active.ctx.createBufferSource();
        const filter = active.ctx.createBiquadFilter();

        source.buffer = active.noise;
        filter.type = type;
        filter.frequency.value = frequency;

        source.connect(filter).connect(envelope(active, when, peak, decay));
        source.start(when);
        source.stop(when + decay + 0.02);
      }

      function kick(active: Audio, when: number, level: number): void {
        const osc = active.ctx.createOscillator();
        osc.type = "sine";
        osc.frequency.setValueAtTime(150, when);
        osc.frequency.exponentialRampToValueAtTime(45, when + 0.12);
        osc.connect(envelope(active, when, level * 0.9, 0.3));
        osc.start(when);
        osc.stop(when + 0.34);
      }

      function drum(active: Audio, band: number, when: number, level: number) {
        if (band === 0) kick(active, when, level);
        else if (band === 1)
          burst(active, when, "bandpass", 1900, level * 0.5, 0.14);
        else burst(active, when, "highpass", 7500, level * 0.3, 0.045);
      }

      function position(): number {
        if (!audio || audioTimer === undefined) return -1;
        const elapsed = audio.ctx.currentTime - audio.startedAt;
        if (elapsed < 0) return 0;
        return ((elapsed / LOOP_S) * FIELD_W) % FIELD_W;
      }

      // Reads the single column sitting under the play bar and moves the
      // oscillator bank to match it. Runs far faster than the frame rate so
      // that a drum onset lands where it was drawn rather than on the next
      // repaint.
      function listen(): void {
        const active = audio;
        if (!active) return;

        const scroll = position();
        if (scroll < 0) return;

        const col = Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W;
        const now = active.ctx.currentTime;

        for (let i = 0; i < active.voices.length; i++) {
          const level = field[at(col, DRUM_BANDS + i)];
          active.voices[i].gain.gain.setTargetAtTime(
            level * level * 0.13,
            now,
            0.04,
          );
        }

        for (let band = 0; band < DRUM_BANDS; band++) {
          const level = field[at(col, band)];
          if (level >= ONSET && lastDrum[band] < ONSET) {
            drum(active, band, now, level);
          }
          lastDrum[band] = level;
        }
      }

      function start(): Audio {
        const active = ensureAudio();
        if (active.ctx.state === "suspended") void active.ctx.resume();

        if (audioTimer === undefined) {
          active.startedAt = active.ctx.currentTime;
          stage?.setAttribute("data-live", "");
          audioTimer = window.setInterval(listen, AUDIO_TICK_MS);
        }
        return active;
      }

      // ---- painting ---------------------------------------------------------

      function paint(
        col: number,
        band: number,
        wipe: boolean,
        amount: number,
      ): void {
        const reachX = Math.ceil(BRUSH_X);
        const reachY = Math.ceil(BRUSH_Y);

        for (let dy = -reachY; dy <= reachY; dy++) {
          const y = band + dy;
          if (y < 0 || y >= BANDS) continue;

          for (let dx = -reachX; dx <= reachX; dx++) {
            const falloff = 1 - Math.hypot(dx / BRUSH_X, dy / BRUSH_Y);
            if (falloff <= 0) continue;

            // Time wraps: the loop is a ring, so a stroke over the seam
            // carries on rather than stopping at an invisible edge.
            const x = (col + dx + FIELD_W) % FIELD_W;
            const i = at(x, y);
            const add = amount * falloff;

            field[i] = wipe
              ? Math.max(0, field[i] - add * 2.5)
              : Math.min(1, field[i] + add);
          }
        }
      }

      // A pointer reports where it is, not the path it took, so a quick drag
      // arrives as a handful of far-apart samples. Stamping along the line
      // between the last mark and this one keeps a fast gesture a line rather
      // than a row of dots.
      function stroke(
        from: [number, number],
        to: [number, number],
        wipe: boolean,
        amount: number,
      ): void {
        let dx = to[0] - from[0];
        if (dx > FIELD_W / 2) dx -= FIELD_W;
        if (dx < -FIELD_W / 2) dx += FIELD_W;
        const dy = to[1] - from[1];

        const steps = Math.max(
          1,
          Math.ceil(Math.max(Math.abs(dx) / 2, Math.abs(dy) * 2)),
        );

        for (let i = 1; i <= steps; i++) {
          const t = i / steps;
          paint(
            Math.round(from[0] + dx * t + FIELD_W) % FIELD_W,
            Math.round(from[1] + dy * t),
            wipe,
            amount,
          );
        }
      }

      function fieldFromScreen(
        clientX: number,
        clientY: number,
      ): [number, number] | null {
        if (!canvas) return null;

        const box = canvas.getBoundingClientRect();
        const fx = (clientX - box.left) / box.width;
        const fy = (clientY - box.top) / box.height;
        if (fx < 0 || fx > 1 || fy < 0 || fy > 1) return null;

        const scroll = Math.max(0, position());
        const col = Math.floor(scroll + fx * FIELD_W) % FIELD_W;
        const band = BANDS - 1 - Math.floor(fy * BANDS);
        return [col, Math.min(BANDS - 1, Math.max(0, band))];
      }

      // ---- drawing ----------------------------------------------------------

      function heat(level: number, out: Uint8ClampedArray, o: number): void {
        const scaled = Math.min(0.999, Math.max(0, level)) * (HEAT.length - 1);
        const i = Math.floor(scaled);
        const t = scaled - i;
        const a = HEAT[i];
        const b = HEAT[Math.min(HEAT.length - 1, i + 1)];

        out[o] = a[0] + (b[0] - a[0]) * t;
        out[o + 1] = a[1] + (b[1] - a[1]) * t;
        out[o + 2] = a[2] + (b[2] - a[2]) * t;
        out[o + 3] = 255;
      }

      function draw(): void {
        frame = requestAnimationFrame(draw);
        if (!canvas || !offCtx || !offImage) return;

        const ctx2d = canvas.getContext("2d");
        if (!ctx2d) return;

        const dpr = window.devicePixelRatio || 1;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (width === 0 || height === 0) return;

        if (canvas.width !== Math.round(width * dpr)) {
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
        }

        if (painting) {
          const cell = fieldFromScreen(pointerX, pointerY);
          if (cell) {
            if (lastMark) stroke(lastMark, cell, erasing, FLOW);
            else paint(cell[0], cell[1], erasing, FLOW);
            lastMark = cell;
          }
        }

        for (let band = 0; band < BANDS; band++) {
          const row = (BANDS - 1 - band) * FIELD_W;
          for (let col = 0; col < FIELD_W; col++) {
            heat(field[at(col, band)], offImage.data, (row + col) * 4);
          }
        }
        offCtx.putImageData(offImage, 0, 0);

        ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx2d.imageSmoothingEnabled = true;
        ctx2d.clearRect(0, 0, width, height);

        // The screen holds exactly one loop, drawn in two pieces so it can
        // scroll continuously through the seam.
        const scroll = Math.max(0, position());
        const px = width / FIELD_W;
        const head = FIELD_W - scroll;

        ctx2d.drawImage(off, scroll, 0, head, BANDS, 0, 0, head * px, height);
        ctx2d.drawImage(off, 0, 0, scroll, BANDS, head * px, 0, scroll * px, height);

        const split = (BANDS - DRUM_BANDS) / BANDS;
        ctx2d.fillStyle = "rgba(255,255,255,0.05)";
        ctx2d.fillRect(0, split * height, width, 1);

        const barX = BAR_FRAC * width;
        const glow = ctx2d.createLinearGradient(barX - 90, 0, barX, 0);
        glow.addColorStop(0, "rgba(255,255,255,0)");
        glow.addColorStop(1, "rgba(255,255,255,0.10)");
        ctx2d.fillStyle = glow;
        ctx2d.fillRect(barX - 90, 0, 90, height);

        ctx2d.fillStyle = "rgba(255,255,255,0.85)";
        ctx2d.fillRect(barX - 1, 0, 2, height);

        if (showCursor) {
          const bandH = height / BANDS;
          const y = (BANDS - 1 - cursorBand) * bandH;
          ctx2d.strokeStyle = "rgba(127,212,193,0.95)";
          ctx2d.lineWidth = 2;
          ctx2d.strokeRect(barX - 14, y, 28, bandH);
        }
      }

      // ---- input ------------------------------------------------------------

      if (canvas) {
        canvas.addEventListener("pointerdown", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;

          const cell = fieldFromScreen(pointerX, pointerY);
          if (!cell) return;

          canvas.setPointerCapture(event.pointerId);
          painting = true;
          erasing = event.shiftKey || event.button === 2;
          showCursor = false;
          stage?.setAttribute("data-touched", "");

          start();
          paint(cell[0], cell[1], erasing, TAP);
          lastMark = cell;
        });

        // Only records where the pointer is. The painting itself happens in
        // the frame loop, because the field scrolls underneath a held brush —
        // holding still has to keep laying down sound, and no pointer event
        // fires while the pointer is not moving.
        canvas.addEventListener("pointermove", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;
        });

        for (const ending of ["pointerup", "pointercancel"] as const) {
          canvas.addEventListener(ending, () => {
            painting = false;
            lastMark = null;
          });
        }

        canvas.addEventListener("contextmenu", (event) => {
          event.preventDefault();
        });

        canvas.addEventListener("keydown", (event) => {
          if (event.key === "ArrowUp" || event.key === "ArrowDown") {
            cursorBand = Math.min(
              BANDS - 1,
              Math.max(0, cursorBand + (event.key === "ArrowUp" ? 1 : -1)),
            );
            showCursor = true;
            event.preventDefault();
            return;
          }

          if (event.key === "Enter" || event.key === " ") {
            showCursor = true;
            stage?.setAttribute("data-touched", "");

            // Paints at the bar, so the mark is heard now and again each time
            // the loop comes round — the keyboard plays it live rather than
            // editing a grid.
            start();
            const scroll = Math.max(0, position());
            paint(
              Math.floor(scroll + BAR_FRAC * FIELD_W) % FIELD_W,
              cursorBand,
              event.shiftKey,
              TAP,
            );
            event.preventDefault();
          }
        });
      }

      clearButton?.addEventListener("click", () => {
        field.fill(0);
      });

      draw();

      // Without this, every hot reload in development leaves the previous
      // module's oscillators and interval running — the page keeps playing a
      // drawing that is no longer on screen.
      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          if (audioTimer !== undefined) window.clearInterval(audioTimer);
          if (frame !== undefined) cancelAnimationFrame(frame);
          void audio?.ctx.close();
          audio = null;
        });
      }
    </script>
  </body>
</html>
